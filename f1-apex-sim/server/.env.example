# OpenF1 sponsor credentials. Keep these in server/.env only.
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_TOKEN_URL=https://api.openf1.org/token
OPENF1_MQTT_HOST=mqtt.openf1.org
OPENF1_MQTT_PORT=8883
OPENF1_MQTT_WS_URL=wss://mqtt.openf1.org:8084/mqtt

# mqtts is recommended for Node.js. Set to wss if port 8883 is unavailable.
OPENF1_MQTT_TRANSPORT=mqtts

LIVE_GATEWAY_PORT=8787
FRONTEND_ORIGIN=

# Optional tuning. Defaults are safe for local development.
OPENF1_API_URL=https://api.openf1.org/v1
LIVE_BROADCAST_INTERVAL_MS=100
LIVE_SESSION_IDLE_TIMEOUT_MS=90000
LIVE_STALE_DRIVER_MS=10000
LIVE_MAX_WS_CLIENTS=100
LIVE_REMOTE_REPLAY_FALLBACK=true
LIVE_REPLAY_WINDOW_MS=120000
LIVE_REPLAY_SPEED=4
